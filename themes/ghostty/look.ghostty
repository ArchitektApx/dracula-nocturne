# Dracula Nocturne for Ghostty, the look. Generated from palette.toml by `nocturne build`: edit that, not this.

background-opacity = 0.7
background-blur = 20
unfocused-split-opacity = 0.85
cursor-style = block
cursor-style-blink = true
custom-shader = shaders/cursor_trail.glsl
macos-titlebar-style = hidden
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
