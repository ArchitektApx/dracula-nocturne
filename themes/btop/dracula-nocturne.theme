# Dracula Nocturne for btop. Generated from palette.toml by `nocturne build`: edit that, not this.
# In btop's themes folder, with color_theme = "dracula-nocturne" in btop.conf.

theme[main_bg]="#0a0a0a"
theme[main_fg]="#f8f8f2"
theme[title]="#f8f8f2"
