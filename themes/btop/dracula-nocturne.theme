theme[selected_bg]="#35374a"
theme[selected_fg]="#f8f8f2"
theme[inactive_fg]="#44475a"
theme[graph_text]="#6272a4"
theme[meter_bg]="#21222c"
theme[proc_misc]="#ff79c6"
theme[cpu_box]="#bd93f9"
theme[mem_box]="#bd93f9"
theme[net_box]="#bd93f9"
theme[proc_box]="#bd93f9"
theme[div_line]="#21222c"
